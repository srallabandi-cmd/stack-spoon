# Primary: Gemini for /api/diagnose and /api/propose
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional fallback if Google key is missing
OPENAI_API_KEY=

# If neither key is set, diagnose/propose fall back to keyword mode.

# Auth (magic link) — required in production (32+ chars)
AUTH_SECRET=
APP_URL=http://127.0.0.1:3000

# Postgres for Vercel Soft Launch (Neon). Local file store is used when unset.
DATABASE_URL=

# Contact + magic-link email (Resend)
# onboarding@resend.dev can only email the Resend account owner.
# To send sign-in links to any invitee, verify a domain at resend.com/domains
# and set CONTACT_FROM_EMAIL to an address on that domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=rallabandiai@gmail.com
CONTACT_FROM_EMAIL=Stack Spoon <onboarding@resend.dev>

# Slack read (user token). Callback: {APP_URL}/api/connectors/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Linear write on Approve. Callback: {APP_URL}/api/connectors/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Kill switches
PROPOSE_DISABLED=false
WRITEBACK_DISABLED=false
